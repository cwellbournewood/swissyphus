{
  "$description": "Swissyphus design tokens. Source of truth: docs/brand/BRAND.md.",
  "color": {
    "signal-red": { "value": "#E5322D", "use": "mark, primary actions, links, highlights" },
    "ink": { "value": "#0B0F19", "use": "text on light, dark backgrounds" },
    "snow": { "value": "#F7F6F3", "use": "light backgrounds, text on dark" },
    "slate": { "value": "#5B6472", "use": "secondary text on light" },
    "mist": { "value": "#AEB4BE", "use": "secondary text on dark" },
    "glacier": { "value": "#7CC4E8", "use": "code keys, data accents, secondary chart series" },
    "night": { "value": "#111827", "use": "code blocks and cards on dark" }
  },
  "font": {
    "sans": { "value": "Inter, system-ui, sans-serif", "weights": [400, 600, 700, 800] },
    "mono": { "value": "'JetBrains Mono', ui-monospace, monospace", "weights": [400, 600] }
  },
  "radius": { "sm": "6px", "md": "10px", "lg": "14px", "icon": "22%" },
  "letter-spacing": { "headline": "-0.03em", "body": "0" },
  "assets": {
    "mark": "assets/logo.svg",
    "icon": "assets/icon.svg",
    "icon-png-512": "assets/icon.png",
    "banner-light": "assets/banner-light.png",
    "banner-dark": "assets/banner-dark.png",
    "social-preview": "assets/social-preview.png"
  }
}
