{
  "name": "swissyphus",
  "mcpName": "io.github.cwellbournewood/swissyphus",
  "version": "1.0.1",
  "description": "Swissyphus, the Swiss public-data rollup for AI agents: 66 public sources in one MCP server and REST API. 151 tools, zero API keys, and every answer cited down to the exact upstream request.",
  "type": "module",
  "bin": {
    "swissyphus": "dist/index.js"
  },
  "main": "dist/index.js",
  "homepage": "https://github.com/cwellbournewood/swissyphus#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cwellbournewood/swissyphus.git"
  },
  "bugs": {
    "url": "https://github.com/cwellbournewood/swissyphus/issues"
  },
  "author": "Swissyphus contributors (https://github.com/cwellbournewood/swissyphus)",
  "files": [
    "dist",
    "manifest.json",
    "README.md",
    "LICENSE",
    "PRIVACY.md",
    "ROPA.md",
    "BREACH_RESPONSE.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "catalogue": "node dist/scripts/catalogue.js",
    "manifest": "npm run build && node dist/scripts/manifest.js",
    "validate:manifest": "npm run manifest && npx --yes @anthropic-ai/mcpb@^2 validate manifest.json",
    "bundle": "npm run manifest && npx --yes @anthropic-ai/mcpb@^2 pack . swissyphus.mcpb",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:live": "npm run build && node test/smoke.mjs",
    "test:rest": "npm run build && node test/rest.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "switzerland",
    "swiss",
    "open-data",
    "zefix",
    "meteoswiss",
    "swisstopo",
    "sbb",
    "fedlex",
    "ai-agent",
    "mcp-server",
    "provenance",
    "data-attribution",
    "opendata-swiss",
    "geo-admin",
    "sanctions",
    "claude"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
