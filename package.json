{
  "name": "swissyphus",
  "version": "0.4.0",
  "description": "Swissyphus — The AI gateway to Switzerland. Zero-key MCP server for Swiss public data: companies, transport, weather, hydrology, geodata, law, statistics, parliament, avalanche, snow, earthquakes, exchange rates, holidays and more. Source attribution on every response.",
  "type": "module",
  "bin": {
    "swissyphus": "dist/index.js"
  },
  "main": "dist/index.js",
  "homepage": "https://github.com/cwellbournewood/swissyphus#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cwellbournewood/swissyphus.git"
  },
  "bugs": {
    "url": "https://github.com/cwellbournewood/swissyphus/issues"
  },
  "author": "Swissyphus contributors (https://github.com/cwellbournewood/swissyphus)",
  "files": [
    "dist",
    "manifest.json",
    "README.md",
    "LICENSE",
    "PRIVACY.md",
    "ROPA.md",
    "BREACH_RESPONSE.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "catalogue": "node dist/scripts/catalogue.js",
    "manifest": "npm run build && node dist/scripts/manifest.js",
    "validate:manifest": "npm run manifest && npx --yes @anthropic-ai/mcpb@^2 validate manifest.json",
    "bundle": "npm run manifest && npx --yes @anthropic-ai/mcpb@^2 pack . swissyphus.mcpb",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:live": "npm run build && node test/smoke.mjs",
    "test:rest": "npm run build && node test/rest.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "switzerland",
    "swiss",
    "open-data",
    "zefix",
    "meteoswiss",
    "swisstopo",
    "sbb",
    "fedlex",
    "ai-agent"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^3.24.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
