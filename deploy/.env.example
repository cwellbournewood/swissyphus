# Copy to .env and fill in before `docker compose up -d`.
#   cp .env.example .env && chmod 600 .env

# The domain/subdomain pointed at this VPS, e.g. api.yourdomain.ch
DOMAIN=api.yourdomain.ch

# Used only for Let's Encrypt renewal notices — not exposed publicly.
EMAIL=you@example.com

# Secret guarding /v1/admin/*. It must be at least 32 characters. A shorter
# or empty value leaves admin DISABLED (every /v1/admin/* call gets 403, and a
# warning is logged at startup). Generate one with:
#   openssl rand -hex 32
# and paste the 64-character result below. Don't put it in shell history,
# commit it or paste it in chat. If it may have leaked, rotate it: edit it
# here, then `docker compose up -d`.
ADMIN_TOKEN=

# Optional: pin an image version instead of :latest (e.g. v0.5.0). Pinning
# makes upgrades explicit and rollbacks trivial.
# SWISSYPHUS_TAG=v0.5.0

# Optional: official ZefixPublicREST credentials issued by the Federal Office
# of Justice (see docs/outreach/foj-zefix-public-rest.md). If you leave them
# empty, the companies module uses the keyless fallback.
ZEFIX_USER=
ZEFIX_PASS=
